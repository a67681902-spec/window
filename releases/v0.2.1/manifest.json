{
  "manifest_version": 3,
  "name": "티모 제목 템플릿 생성기",
  "description": "아파트 데이터에서 티모용 제목 템플릿을 만듭니다. 자동 갱신 도우미 연동.",
  "version": "0.2.1",
  "action": {
    "default_title": "티모 제목 템플릿 생성기",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "background": {
    "service_worker": "worker.js"
  },
  "permissions": [
    "alarms",
    "nativeMessaging"
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "host_permissions": [
    "https://raw.githubusercontent.com/*"
  ]
}
