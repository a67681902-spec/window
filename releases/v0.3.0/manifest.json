{
  "manifest_version": 3,
  "name": "티모 제목·배포 도우미",
  "description": "티모 제목 템플릿 생성, GitHub 자동 업데이트 및 플레이스 배포 화면 입력 구조 점검.",
  "version": "0.3.0",
  "action": {
    "default_title": "티모 제목 템플릿 생성기",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "background": {
    "service_worker": "worker.js"
  },
  "permissions": [
    "activeTab",
    "alarms",
    "nativeMessaging",
    "scripting"
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "host_permissions": [
    "https://raw.githubusercontent.com/*"
  ]
}
